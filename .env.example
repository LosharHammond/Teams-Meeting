# ============================================================
# Teams Meeting Summarizer — Configuration
# ============================================================
# Copy this file to .env and fill in your values.

# --- Azure AD App Registration ---
# Create at https://portal.azure.com > App registrations
# Required API permissions (Application type):
#   - OnlineMeetings.Read.All
#   - OnlineMeetingTranscript.Read.All
#   - Calendars.Read
#   - User.Read.All
#   - Mail.Send
# Then grant admin consent for your tenant.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=




 



# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Meeting Organizer ---
# The Teams user whose meetings to monitor and summarize.
ORGANIZER_EMAIL=

# Who the recap email is sent FROM (defaults to ORGANIZER_EMAIL)
SENDER_EMAIL=

# --- Options ---
# How many hours back to check for meetings (default: 24)
LOOKBACK_HOURS=24

# How often to poll for new transcripts, in seconds (default: 60)
# Lower = faster recap delivery, but more API calls
POLL_INTERVAL=60


# File path for tracking processed meetings (prevents duplicates)
PROCESSED_FILE=processed_meetings.json

# ── Database (Neon / Supabase / Vercel Postgres) ─────────────
DATABASE_URL=

# ── Security ─────────────────────────────────────────────────
# Set this in Vercel dashboard too — Vercel sends it on every cron request
CRON_SECRET=generate-a-long-random-string-here-and-set-it-in-vercel-dashboard
