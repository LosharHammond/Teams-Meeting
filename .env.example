# ============================================================
# Teams Meeting Summarizer — Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.

# --- Azure AD App Registration ---
# Create at https://portal.azure.com > App registrations
# Required API permissions (Application type):
#   - OnlineMeetings.Read.All
#   - OnlineMeetingTranscript.Read.All
#   - Calendars.Read
#   - User.Read.All
#   - Mail.Send
# Then grant admin consent for your tenant.

AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=whisper-1

# --- Meeting Organizer ---
# The Teams user whose calendar to scan as fallback.
ORGANIZER_EMAIL=someone@yourdomain.com

# Who the recap email is sent FROM (defaults to ORGANIZER_EMAIL)
SENDER_EMAIL=someone@yourdomain.com

# --- Options ---
# How many hours back to scan for ended meetings (default: 4)
LOOKBACK_HOURS=4

# How many hours to wait for a transcript before giving up (default: 26)
TRANSCRIPT_TIMEOUT_HOURS=26

# ── Database ──────────────────────────────────────────────────
# Railway: copy the DATABASE_URL from your Railway Postgres plugin
# Neon / Supabase: paste your connection string here
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Security ──────────────────────────────────────────────────
# Random string — set the same value in Railway environment variables
CRON_SECRET=generate-a-long-random-string-here

# ── ACS Bot Recording (optional) ──────────────────────────────
# Set ENABLE_BOT_RECORDING=true to have a bot auto-join meetings and
# record audio so recaps work even when participants don't record manually.
#
# Setup steps:
#   1. Create an Azure Communication Services resource:
#      https://portal.azure.com > Create a resource > Communication Services
#   2. Copy the connection string from "Keys" in your ACS resource.
#
#   3. Create an Azure Storage account + container named "recordings":
#      https://portal.azure.com > Storage accounts > Create
#      Copy the connection string from "Access keys".
#
#   4. Set ACS_CALLBACK_BASE_URL to your Railway app's public URL
#      (e.g. https://teams-summarizer-production.up.railway.app)
#      ACS will POST webhook events to /api/acs-callback on that URL.
#
#   5. Allow ACS to join Teams meetings — in Azure portal, go to your
#      ACS resource > Settings > Teams interoperability > Enable.
#
# The bot appears in the meeting as BOT_DISPLAY_NAME so participants
# are aware the meeting is being recorded.

ENABLE_BOT_RECORDING=false
ACS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=...
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
ACS_CALLBACK_BASE_URL=https://your-app.up.railway.app
BOT_DISPLAY_NAME=Procus Meeting Recorder
RECORDINGS_CONTAINER=recordings
